# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# VK community
VK_GROUP_TOKEN=
VK_GROUP_ID=

# Use a persistent directory supplied by your hosting provider in production.
DATABASE_PATH=./data/vkhelper.sqlite3

# Recipient of manager notifications. Values here override corresponding values
# in data/business.json when set.
MANAGER_VK_ID=
MANAGER_VK_URL=

# Daily manager notification, in the configured IANA timezone.
TIMEZONE=Asia/Yekaterinburg
DAILY_SUMMARY_HOUR=20
